# Copy this file to .env and fill in real values. .env is ignored by git.
CESIUM_ION_TOKEN=
GEMINI_API_KEY=
# optional
GEMINI_MODEL=
API_PORT=
API_HOST=
TRUST_PROXY=
# Gemini without an API key: Vertex AI with Google sign-in (gcloud auth login --update-adc) or Cloud Run identity
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
